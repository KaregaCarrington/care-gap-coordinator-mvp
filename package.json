{
  "name": "care-gap-coordinator",
  "version": "0.1.0",
  "description": "Local-first care gap coordinator desktop application",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "electron . --dev",
    "dist": "npm run build && electron-builder",
    "test": "npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron-updater": "latest",
    "exceljs": "latest",
    "react": "latest",
    "react-dom": "latest",
    "xlsx": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "concurrently": "latest",
    "electron": "^25.9.8",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.caregapcoordinator.app",
    "productName": "Care Gap Coordinator",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "rules/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
